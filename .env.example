PORT=4000
CLIENT_URL=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=revtrove
MYSQL_PASSWORD=revtrove_local_password
MYSQL_DATABASE=revtrove
MYSQL_ROOT_PASSWORD=revtrove_local_password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@revtrove.local
# Set a strong password for initial creation only; existing accounts use Firestore.
ADMIN_PASSWORD=
AUTO_PRINT_ENABLED=false
PRINT_COMMAND=
# Firebase Admin: server only. Never put these in client/.env.local or VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only password recovery email (never VITE_)
RESEND_API_KEY=
MAIL_FROM=
# Canonical HTTPS production origin used to create reset links
PASSWORD_RESET_URL=https://revtrove.vercel.app


