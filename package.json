{
  "name": "revtrove-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n client,server -c yellow,cyan \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:init": "npm run db:init -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
